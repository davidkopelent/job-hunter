# Copy to .env. Used by the Python pipeline and scoring (locally and as GitHub Actions secrets).

# Gmail address that receives the job alerts, and an app password for it (16 letters, no spaces).
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=abcdefghijklmnop

# Supabase → Connect → Session pooler (port 5432).
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
