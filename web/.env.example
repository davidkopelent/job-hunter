# Copy to web/.env (and set the same variables on Vercel).

# Same as the Python DATABASE_URL, but the transaction pooler: port 6543.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# The feed's login password. Changing it logs everyone out.
APP_PASSWORD=<long random password>
